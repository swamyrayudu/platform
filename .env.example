# ==============================================================================
# Environment Variables Example for DSC Platform
# Copy this file to .env.local for local development:
#   cp .env.example .env.local
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application Configuration
# ------------------------------------------------------------------------------
# Base URL for the application (used in CORS configuration & redirects)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Set to "true" when running behind a trusted reverse proxy (e.g., Vercel, Nginx)
# Set to "false" for local development
#
# SECURITY: x-forwarded-for and x-real-ip are ordinary request headers that any
# client can forge. They are only trusted when TRUST_PROXY=true, because a proxy
# is then overwriting them at the edge.
#
# PRODUCTION: set this to "true". With "false", getClientIp() returns 'unknown'
# for everyone, so all per-IP auth rate limits (login, refresh, logout) share a
# single bucket and one abuser can lock out every user.
TRUST_PROXY=false


# ------------------------------------------------------------------------------
# 2. Supabase Configuration
# ------------------------------------------------------------------------------
# Supabase Project URL (Supabase Dashboard -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anon / Publishable Key (Public, safe for client-side use)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-or-publishable-key

# Supabase Service Role Key (SERVER ONLY - NEVER expose with NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key


# ------------------------------------------------------------------------------
# 3. Google OAuth Configuration
# ------------------------------------------------------------------------------
# Google OAuth Client ID for frontend Google Identity Services (GIS) button
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Google OAuth Client ID for server-side token verification (audience match)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com


# ------------------------------------------------------------------------------
# 4. Security & Cryptographic Secrets
# ------------------------------------------------------------------------------
# Secret key used for signing/verifying JWT access tokens & refresh token HMACs
# MUST be at least 32 characters long
JWT_SECRET=replace_with_a_secure_random_string_at_least_32_characters_long

# Secret key used for HMAC-SHA256 hashing of client IP addresses for privacy
# MUST be at least 16 characters long
IP_HASH_SECRET=replace_with_a_secure_random_string_at_least_16_characters_long


# ------------------------------------------------------------------------------
# 5. Rate Limiting Configuration
# ------------------------------------------------------------------------------
# Provider: "memory" (default for single-instance / local dev) or "redis" (multi-instance / production)
RATE_LIMIT_PROVIDER=memory

# Upstash Redis credentials (Required only if RATE_LIMIT_PROVIDER=redis)
UPSTASH_REDIS_REST_URL=https://your-redis-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-redis-rest-token


# ------------------------------------------------------------------------------
# 6. Razorpay Payments (SERVER ONLY — never prefix with NEXT_PUBLIC_)
# ------------------------------------------------------------------------------
# Razorpay Dashboard -> Account & Settings -> API Keys
# Use rzp_test_* keys locally and rzp_live_* keys in production.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your-razorpay-key-secret

# Razorpay Dashboard -> Account & Settings -> Webhooks -> Add New Webhook
#   URL:    https://<your-domain>/api/payments/webhook
#   Events: payment.captured, payment.failed, order.paid
# The "Secret" you type into that form goes here.
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret

# Google One Tap: the automatic "continue as <name>" card on the landing page.
# Off by default. Requires FedCM to work in the browser AND the origin you
# serve from to be listed under the OAuth client's Authorized JavaScript
# origins in Google Cloud Console — otherwise Google's library logs
# "FedCM get() rejects with NetworkError" on every page load.
NEXT_PUBLIC_GOOGLE_ONE_TAP=false
